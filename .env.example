# Louvre Dental Centre — environment variables
# Set these in Vercel: Project Settings -> Environment Variables (Production + Preview).
# The appointment form (api/send.js) uses them to email the front desk.

SMTP_HOST=          # e.g. smtp.your-host.com
SMTP_PORT=587       # 587 (STARTTLS) or 465 (SMTPS)
SMTP_USER=          # sending mailbox username
SMTP_PASS=          # mailbox password / app password

# Optional (have defaults)
TO_EMAIL=info@louvredental.ca
# FROM_EMAIL=no-reply@louvredental.ca
# SITE_URL=https://louvredental.ca
